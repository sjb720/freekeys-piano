{
  "name": "freekeys",
  "productName": "FreeKeys",
  "version": "0.1.3",
  "description": "Open-source piano practice app: falling notes, wait mode, MIDI and mic input.",
  "license": "MIT",
  "desktopName": "freekeys.desktop",
  "author": "FreeKeys contributors",
  "homepage": "https://github.com/sjb720/freekeys-piano",
  "repository": {
    "type": "git",
    "url": "https://github.com/sjb720/freekeys-piano.git"
  },
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:linux": "pnpm build && electron-builder --linux --publish never",
    "package:win": "pnpm build && electron-builder --win --publish never",
    "format:check": "prettier --check .",
    "release": "node scripts/release.mts",
    "demos": "node scripts/generate-demos.mts"
  },
  "dependencies": {
    "@tonejs/midi": "^2.0.28"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "lucide-react": "^1.77.0",
    "pixi.js": "^8.23.0",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stylelint": "^18.1.0",
    "stylelint-config-standard": "^41.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "zustand": "^5.1.0"
  },
  "packageManager": "pnpm@11.22.0"
}
